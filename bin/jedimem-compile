#!/usr/bin/env python3
"""Compile .jedimem/memories/*.md into the instruction files agents already read.

Deterministic, no LLM, no network. Output is byte-stable for a given input so it
can be committed as a generated artifact and CI-checked for staleness.

Usage:
  jedimem-compile            rewrite the delimited section in each target
  jedimem-compile --check    exit 1 if any target is stale (for CI)
"""
import sys, os, re, hashlib, pathlib

ROOT = pathlib.Path(__file__).resolve().parent.parent
MEMDIR = ROOT / ".jedimem" / "memories"
BEGIN = "<!-- BEGIN jedimem -->"
END = "<!-- END jedimem -->"
TARGETS = ["AGENTS.md", "CLAUDE.md"]
ALWAYS_BUDGET = 6000          # see .jedimem/config.yml; demote, never truncate

# Order is part of the contract: tier, then kind, then id. Never mtime.
TIER_ORDER = {"always": 0, "scoped": 1, "on_demand": 2, "pre_action": 3}


def parse(path):
    text = path.read_text(encoding="utf-8")
    if not text.startswith("---\n"):
        raise ValueError(f"{path.name}: missing frontmatter")
    fm_raw, _, body = text[4:].partition("\n---\n")
    fm, stack = {}, []
    for line in fm_raw.splitlines():
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        indent = len(line) - len(line.lstrip())
        key, _, val = line.strip().partition(":")
        val = val.strip().strip('"')
        if indent == 0:
            fm[key] = val
            stack = [key]
        elif stack:                                  # one nesting level is enough
            fm.setdefault(stack[0] + "_map", {})[key] = val
    fm["_body"] = body.strip()
    fm["_file"] = path.name
    return fm


def load():
    if not MEMDIR.is_dir():
        return []
    mems = [parse(p) for p in sorted(MEMDIR.glob("*.md"))]
    return [m for m in mems if m.get("status") == "active"]


def render(mems):
    """Render the always-tier block, demoting overflow rather than truncating."""
    mems = sorted(mems, key=lambda m: (TIER_ORDER.get(m.get("tier", "on_demand"), 9),
                                       m.get("kind", ""), m.get("id", "")))
    always = [m for m in mems if m.get("tier") == "always"]

    lines = [BEGIN,
             "<!-- GENERATED by jedimem-compile. Do not edit inside these markers;",
             "     edit .jedimem/memories/*.md instead. Content outside the markers",
             "     is yours and always wins. -->",
             ""]
    used, demoted = 0, []
    for m in always:
        # First PARAGRAPH, not first physical line: bodies are hard-wrapped,
        # so splitlines()[0] would truncate the rule mid-sentence.
        para = []
        for ln in m["_body"].splitlines():
            if not ln.strip():
                break
            para.append(ln.strip())
        block = f"- **[{m.get('kind','?')}]** {' '.join(para)}\n"
        scope = m.get("scope", "**")
        if scope not in ("**", ""):
            block = block.rstrip("\n") + f"  _(scope: `{scope}`)_\n"
        if used + len(block) > ALWAYS_BUDGET:
            demoted.append(m)
            continue
        lines.append(block.rstrip("\n"))
        used += len(block)

    if demoted:
        lines += ["",
                  f"<!-- {len(demoted)} memory(ies) demoted from the always tier:",
                  f"     budget {ALWAYS_BUDGET} chars exceeded. Retrieve on demand. -->"]
    lines += ["", END]
    return "\n".join(lines) + "\n"


def splice(existing, section):
    if BEGIN in existing and END in existing:
        pre = existing.split(BEGIN)[0]
        post = existing.split(END, 1)[1]
        return pre + section + post.lstrip("\n")
    sep = "" if existing.endswith("\n\n") or not existing else "\n"
    return existing + sep + "\n" + section


def main():
    check = "--check" in sys.argv
    mems = load()
    section = render(mems)
    stale = []
    for name in TARGETS:
        p = ROOT / name
        cur = p.read_text(encoding="utf-8") if p.exists() else ""
        new = splice(cur, section)
        if cur == new:
            continue
        if check:
            stale.append(name)
        else:
            p.write_text(new, encoding="utf-8")
            print(f"compiled -> {name}")
    if check:
        if stale:
            print("STALE (run jedimem-compile): " + ", ".join(stale), file=sys.stderr)
            return 1
        print(f"up to date ({len(mems)} active memories)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
